APP_PROVIDER_BASE_URL=https://jsonplaceholder.typicode.com
APP_PROVIDER_TIMEOUT_SECONDS=5.0

APP_MAX_CONCURRENCY=10
APP_RETRY_ATTEMPTS=3
APP_RETRY_BASE_DELAY_SECONDS=0.2
APP_RETRY_MAX_DELAY_SECONDS=2.0

APP_CACHE_TTL_SECONDS=60
# Sem REDIS_URL o cache usa memoria local; sem DATABASE_URL o espelho e desativado.
# APP_REDIS_URL=redis://localhost:6379/0
# APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/users

APP_CORS_ORIGINS=["http://localhost:5173"]
APP_LOG_LEVEL=INFO
